diff --git a/trylseek.c b/trylseek.c
new file mode 100644
index 0000000..11a0768
--- /dev/null
+++ b/trylseek.c
@@ -0,0 +1,39 @@
+#include "types.h"
+#include "fcntl.h"
+#include "stat.h"
+#include "user.h"
+#include "fs.h"
+
+
+int
+main(int argc, char *argv[])
+{
+  int fd, i, n;
+  char buf[128];
+  fd = open(argv[1], O_RDONLY);
+  lseek(fd, 10, SEEK_SET);
+  n = read(fd, buf, 5);
+  for(i = 0; i < n; i++)
+    printf(1, "%c", buf[i]);
+  printf(1, "\n");
+
+
+  lseek(fd, 10, SEEK_CUR);
+  n = read(fd, buf, 5);
+  for(i = 0; i < n; i++)
+    printf(1, "%c", buf[i]);
+  printf(1, "\n");
+
+  lseek(fd, -5, SEEK_END); 
+  n = read(fd, buf, 5);
+  for(i = 0; i < n; i++)
+    printf(1, "%c", buf[i]);
+  printf(1, "\n");
+
+  lseek(fd, 5, SEEK_END); 
+  n = read(fd, buf, 5);
+  for(i = 0; i < n; i++)
+    printf(1, "%c", buf[i]);
+  printf(1, "\n");
+  exit();
+}
